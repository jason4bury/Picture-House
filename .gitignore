# Builds live in ..\Builds\, outside the repo. Safety net in case one lands here.
*.exe
*.exe.old
*.lnk

# Your own data: settings (with API keys), library, ratings, watched history, artwork cache,
# logs and backups. 1.00+ keeps it in %APPDATA%\Picture House; these catch the old
# "Data" folder (and "Data (moved to AppData)") if a copy is ever left in the repo.
Data/
Data*/

# Logs and temp files (Build.log, launcher logs)
*.log
*.tmp
*.bak

# Local config and secrets
config.local.json
.env
settings.json
secrets*.json
*.key

# Windows clutter
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
*.swp
